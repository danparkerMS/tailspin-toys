---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
    getAllGames(db),
    getAllCategories(db),
    getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <div class="flex flex-wrap gap-4 mb-6 p-4 bg-slate-800/60 border border-slate-700/50 rounded-xl" data-testid="filter-controls" role="search" aria-label="Filter games">
          <div class="flex flex-col gap-1">
            <label for="publisher-filter" class="text-sm font-medium text-slate-300">Publisher</label>
            <select
              id="publisher-filter"
              data-testid="publisher-filter"
              class="bg-slate-900 text-slate-100 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors"
            >
              <option value="">All publishers</option>
              {publishers.map((p) => (
                <option value={String(p.id)}>{p.name}</option>
              ))}
            </select>
          </div>

          <fieldset class="flex flex-col gap-1">
            <legend class="text-sm font-medium text-slate-300 mb-1">Category</legend>
            <div class="flex flex-wrap gap-3" data-testid="category-filters">
              {categories.map((c) => (
                <label class="flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                  <input
                    type="checkbox"
                    value={String(c.id)}
                    data-testid={`category-filter-${c.id}`}
                    class="w-4 h-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  />
                  {c.name}
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex items-end">
            <button
              id="clear-filters"
              data-testid="clear-filters"
              class="px-3 py-2 text-sm text-slate-400 hover:text-slate-100 border border-slate-600 hover:border-slate-400 rounded-lg transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Clear filters
            </button>
          </div>
        </div>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
          <div id="no-results" class="hidden">
            <EmptyState text="No games match the selected filters." />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-filter-item
                data-category-id={String(game.category?.id ?? '')}
                data-publisher-id={String(game.publisher?.id ?? '')}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const publisherSelect = document.getElementById('publisher-filter') as HTMLSelectElement | null;
  const categoryContainer = document.querySelector('[data-testid="category-filters"]');
  const clearBtn = document.getElementById('clear-filters');
  const noResults = document.getElementById('no-results');
  const filterStatus = document.getElementById('filter-status');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-item]'));

  function applyFilters(): void {
    const publisherId = publisherSelect?.value ?? '';
    const checkedCategories = categoryContainer
      ? Array.from(categoryContainer.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')).map(
          (cb) => cb.value,
        )
      : [];

    let visibleCount = 0;

    for (const item of items) {
      const itemPublisher = item.dataset.publisherId ?? '';
      const itemCategory = item.dataset.categoryId ?? '';

      const publisherMatch = publisherId === '' || itemPublisher === publisherId;
      const categoryMatch = checkedCategories.length === 0 || checkedCategories.includes(itemCategory);

      const visible = publisherMatch && categoryMatch;
      item.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    }

    if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
    if (filterStatus) {
      filterStatus.textContent = `${visibleCount} game${visibleCount !== 1 ? 's' : ''} shown`;
    }
  }

  function clearFilters(): void {
    if (publisherSelect) publisherSelect.value = '';
    if (categoryContainer) {
      categoryContainer.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((cb) => {
        cb.checked = false;
      });
    }
    applyFilters();
  }

  publisherSelect?.addEventListener('change', applyFilters);
  categoryContainer?.addEventListener('change', applyFilters);
  clearBtn?.addEventListener('click', clearFilters);
</script>
